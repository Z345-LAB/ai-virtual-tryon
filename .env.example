# 阿里云百炼 API Key（控制台 → API-KEY 管理 获取，形如 sk-xxxxxxxx）
ALIYUN_API_KEY=

# 图像模型：wan2.7-image-pro / wan2.7-image
WAN_MODEL=wan2.7-image-pro

# 输出尺寸：1K / 2K。万相输出 PNG，1K 约 1.6MB，2K 约 5.4MB
WAN_SIZE=2K

# DashScope 域名：华北2(北京) 用 dashscope.aliyuncs.com；新加坡用 dashscope-intl.aliyuncs.com
DASHSCOPE_HOST=https://dashscope.aliyuncs.com

# Tripo 图生 3D（v3 接口，图片直接传公网 URL，不需要先上传）
# 国内站：https://openapi.tripo3d.com/v3　国际站：https://openapi.tripo3d.ai/v3（国内被 DNS 污染）
# 注意：Tripo API 是独立计费（100 credits = $1），Studio 订阅的积分不能用于 API
TRIPO_API_KEY=
TRIPO_HOST=https://openapi.tripo3d.com/v3

# 生成模型：P1-20260311 / P2-20260801 / v2.5-20250123 / v3.0-20250812 / v3.1-20260211
# v3.x 是「雕刻级」高模，网页端很重（实测 139 万面 / 42MB），浏览器基本加载不动。
# 想要网页能流畅展示，用 P1（游戏就绪，500–25K 面）或配合下面的 TRIPO_FACE_LIMIT。
TRIPO_MODEL_VERSION=v3.1-20260211

# 面数上限（可选）。设了才会传 face_limit，比如 30000 能把模型压到几 MB。
# 留空 = 不限制，按模型默认输出（v3.1 会到百万面）。
TRIPO_FACE_LIMIT=

# 贴图精度（可选）：standard / detailed
TRIPO_TEXTURE_QUALITY=

# 智能减面（可选）：true 时额外请求 smart_low_poly
TRIPO_SMART_LOW_POLY=

# Tripo 没有 Key、余额不足或网络不通时，回退到这个演示模型，保证界面不空白
DEMO_MODEL_URL=/models/robot.glb

# 本地服务端口，改这里的话记得同步改 public/index.html 里的 BACKEND_PORT
PORT=3000
